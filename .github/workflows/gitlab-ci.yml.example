# GitLab CI example only. Copy to the repository root as .gitlab-ci.yml in a GitLab project.
# Requires a runner that supports privileged Docker-in-Docker for the image jobs.

stages:
  - pre
  - test
  - build
  - publish
  - deploy

workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_TARGET_BRANCH_NAME =~ /^(development|test|main)$/'
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(development|test|main)$/'
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(feature[-\/]|fix[-\/])/ && $CI_OPEN_MERGE_REQUESTS == null'
    - when: never

variables:
  NPM_CONFIG_CACHE: '$CI_PROJECT_DIR/.npm'

.node_cache: &node_cache
  key:
    files:
      - package-lock.json
    prefix: '$CI_JOB_NAME'
  paths:
    - .npm/

pre_checks:
  stage: pre
  image: node:22-alpine
  cache: *node_cache
  script:
    - npm ci --prefer-offline
    - npm run lint
    - npm run format:check

unit_tests:
  stage: test
  image: node:22-alpine
  cache: *node_cache
  script:
    - npm ci --prefer-offline
    - npm run test:unit

e2e_tests:
  stage: test
  image: mcr.microsoft.com/playwright:v1.62.1-noble
  cache: *node_cache
  variables:
    PLAYWRIGHT_BROWSERS_PATH: /ms-playwright
  script:
    - npm ci --prefer-offline
    - npm run test:e2e -- --project=chromium
  artifacts:
    when: always
    paths:
      - playwright-report/
      - test-results/
    expire_in: 14 days

helm_checks:
  stage: test
  image:
    name: alpine/helm:3.17.3
    entrypoint: ['']
  script:
    - |
      if [ "$CI_PIPELINE_SOURCE" = "merge_request_event" ]; then
        CHART_ENV="$CI_MERGE_REQUEST_TARGET_BRANCH_NAME"
      else
        CHART_ENV="$CI_COMMIT_BRANCH"
      fi
      helm lint "kubernetes/$CHART_ENV"
      helm template fieldline-operations "kubernetes/$CHART_ENV"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH =~ /^(development|test|main)$/'

build_image:
  stage: build
  needs:
    - pre_checks
    - unit_tests
    - e2e_tests
    - helm_checks
  image: docker:27-cli
  services:
    - name: docker:27-dind
      alias: docker
  variables:
    DOCKER_HOST: 'tcp://docker:2375'
    DOCKER_TLS_CERTDIR: ''
  script:
    - docker build -t "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHA" .
    - docker save "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHA" -o image.tar
  artifacts:
    paths:
      - image.tar
    expire_in: 1 day
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(development|test|main)$/'

build_pages:
  stage: build
  needs:
    - pre_checks
    - unit_tests
    - e2e_tests
    - helm_checks
  image: node:22-alpine
  cache: *node_cache
  script:
    - npm ci --prefer-offline
    - |
      BASE_PATH="$(node -e 'const p = new URL(process.env.CI_PAGES_URL).pathname; process.stdout.write(p.endsWith("/") ? p : p + "/")')"
    - npm run build -- --base-href="$BASE_PATH"
    - cp dist/fieldline-operations/browser/index.html dist/fieldline-operations/browser/404.html
  artifacts:
    paths:
      - dist/fieldline-operations/browser/
    expire_in: 1 day
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "development"'

publish_image:
  stage: publish
  image: docker:27-cli
  services:
    - name: docker:27-dind
      alias: docker
  variables:
    DOCKER_HOST: 'tcp://docker:2375'
    DOCKER_TLS_CERTDIR: ''
  needs:
    - job: build_image
      artifacts: true
  script:
    - echo "$CI_REGISTRY_PASSWORD" | docker login "$CI_REGISTRY" -u "$CI_REGISTRY_USER" --password-stdin
    - docker load -i image.tar
    - docker tag "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHA" "$CI_REGISTRY_IMAGE:$CI_COMMIT_REF_NAME"
    - docker push "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHA"
    - docker push "$CI_REGISTRY_IMAGE:$CI_COMMIT_REF_NAME"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(development|test|main)$/'

publish_pages:
  stage: deploy
  image: alpine:3.20
  needs:
    - job: build_pages
      artifacts: true
    - job: publish_image
      artifacts: false
  script:
    - test -s dist/fieldline-operations/browser/index.html
  pages:
    publish: dist/fieldline-operations/browser
  environment:
    name: development-pages
    url: '$CI_PAGES_URL'
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "development"'

